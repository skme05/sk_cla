# URL publique du site (utilisée dans les messages WhatsApp)
NEXT_PUBLIC_SITE_URL=https://gael-et-clarisse.com

# Supabase : Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé « service_role » : uniquement côté serveur, jamais dans le navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe de l'espace mariés (/admin)
ADMIN_PASSWORD=
# Secret aléatoire (32+ caractères) pour signer la session admin et anonymiser les IP
SESSION_SECRET=
