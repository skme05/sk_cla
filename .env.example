# URL publique du site (utilisée dans les messages WhatsApp)
NEXT_PUBLIC_SITE_URL=https://gael-et-clarisse.com

# Supabase : Project Settings > Data API (URL) et Project Settings > API Keys (clé secrète)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé secrète « sb_secret_… » : uniquement côté serveur, jamais dans le navigateur.
# La clé « publishable » n'est pas utilisée : le navigateur ne parle jamais directement à la base.
SUPABASE_SECRET_KEY=

# Mot de passe de l'espace mariés (/admin)
ADMIN_PASSWORD=
# Secret aléatoire (32+ caractères) pour signer la session admin et anonymiser les IP
SESSION_SECRET=
